API_SERVICE_ENV=dev
API_SERVICE_PORT=8001
LOG_LEVEL=INFO
# 钉钉/企微报表简报中的完整报表链接域名
APP_PUBLIC_URL=https://yunshu.example.com
# JSON 数组；生产环境必须填写精确 Origin，禁止使用 "*"
ALLOWED_ORIGINS=["https://yunshu.example.com"]
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
CHAT_RATE_LIMIT=60
CODE_EXECUTION_RATE_LIMIT=10

# Main database type: mysql (default)
DATABASE_TYPE=mysql

# MySQL
MYSQL_HOST=192.168.28.170
MYSQL_PORT=3306
MYSQL_DB=nanzi_ai_agent_platform
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# PostgreSQL (used when DATABASE_TYPE=postgresql)
POSTGRES_HOST=192.168.28.170
POSTGRES_PORT=5432
POSTGRES_DB=nanzi_ai_agent_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Redis
REDIS_HOST=192.168.28.170
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_ENABLE=true

# Security-用户 API Key 的对称加密密钥（Fernet）
API_SERVICE_API_KEY_HASH_ALGORITHM=sha256
# 生成命令：python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=GENERATE_A_UNIQUE_FERNET_KEY


# Jira Integration

JIRA_URL=https://jira.example.com

JIRA_USERNAME=your_username

JIRA_PASSWORD=your_password
