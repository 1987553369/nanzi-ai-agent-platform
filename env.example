API_SERVICE_ENV=dev
API_SERVICE_PORT=8001
LOG_LEVEL=INFO
# 钉钉/企微报表简报中的完整报表链接域名
APP_PUBLIC_URL=https://nanzi.example.com
# JSON 数组；生产环境必须填写精确 Origin，禁止使用 "*"
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8001"]
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
CHAT_RATE_LIMIT=60
CODE_EXECUTION_RATE_LIMIT=10
TOOL_EXECUTION_RATE_LIMIT=30
BROWSER_SESSION_TTL_SECONDS=3600

# Main database type: mysql (default)
DATABASE_TYPE=mysql

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=nanzi_ai_agent_platform
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# PostgreSQL (used when DATABASE_TYPE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nanzi_ai_agent_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_ENABLE=true

# Security-用户 API Key 的对称加密密钥（Fernet）
API_SERVICE_API_KEY_HASH_ALGORITHM=sha256
# 生成命令：python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=GENERATE_A_UNIQUE_FERNET_KEY

# SSO Configuration
SSO_API_URL=https://yovole.net/api/v1/user/check/login
SSO_ACCESS_TOKEN=CHANGE_ME_SSO_ACCESS_TOKEN
SSO_REQUEST_SYSTEM=NANZI_AI_AGENT_PLATFORM
SSO_REQUEST_BUSINESS=USER-LOGIN
SSO_TIMEOUT=30

# RAGFlow Config
RAGFLOW_API_KEY=ragflow-xxxxxxxxxxxxxxxxxxxxxxxx
RAGFLOW_API_URL=http://ragflow-server:9380
# 私网 RAGFlow 必须同时填写精确 Host 与最小 CIDR；JSON 数组，不支持通配符。
RAGFLOW_ALLOWED_PRIVATE_HOSTS=[]
RAGFLOW_ALLOWED_PRIVATE_CIDRS=[]

# OpenClaw / External SQL 私网目标采用各自独立审批，不能复用 RAGFlow 网段权限。
OPENCLAW_ALLOWED_PRIVATE_HOSTS=[]
OPENCLAW_ALLOWED_PRIVATE_CIDRS=[]
EXTERNAL_SQL_ALLOWED_PRIVATE_HOSTS=[]
EXTERNAL_SQL_ALLOWED_PRIVATE_CIDRS=[]

# Jira Integration (Optional)
JIRA_URL=https://jira.example.com
JIRA_USERNAME=your_username
JIRA_PASSWORD=your_password
